APP_NAME=Bulk Certificate Generator
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<postgres-host>:5432/<database>
REDIS_URL=rediss://default:<password>@<redis-host>:6379

# Generated certificates are stored on the local filesystem.
STORAGE_PATH=storage

# X-API-KEY header
API_KEYS=local-dev-key:local-user
CORS_ORIGINS=[]

MAX_JOBS_PER_USER=100
RATE_LIMIT_PER_MINUTE=60
WORKER_CONCURRENCY=4